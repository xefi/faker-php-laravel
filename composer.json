{
  "name": "xefi/faker-php-laravel",
  "type": "library",
  "description": "Faker php integration with laravel",
  "keywords": [
    "faker",
    "data",
    "seeding",
    "fixtures",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Gautier Deleglise"
    }
  ],
  "require": {
    "php": ">=8.3 <8.6",
    "illuminate/support": "^12.0|^13.0",
    "xefi/faker-php": "^1"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11|^12|^13"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "Xefi\\Faker\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Xefi\\Faker\\Laravel\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Xefi\\Faker\\Laravel\\FakerLaravelServiceProvider"
      ]
    }
  }
}
